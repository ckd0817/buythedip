[Unit]
Description=Refresh Buy The Dip daily market data
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=buythedip
WorkingDirectory=/opt/buythedip/current
Environment=MARKET_PUBLISH_DIR=/var/www/buythedip/data
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/buythedip/current/scripts/update_data.py --market US
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
